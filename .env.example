# ============================================================
#  MyNav 环境变量配置示例
#  复制此文件为 .env 并修改相应值
# ============================================================

# ---------- 应用基本配置 ----------
# 应用对外暴露的端口
APP_PORT=3000

# JWT 签名密钥（生产环境请务必修改为随机字符串）
JWT_SECRET=change-me-to-a-random-secret-key-please-use-at-least-32-chars

# 管理员密码（用于服务器级备份加密等管理功能，留空则禁用）
ADMIN_PASSWORD=

# ---------- 数据库配置 ----------
# SQLite 数据库文件路径（容器内路径，无需修改）
DATABASE_PATH=/app/data/database.db

# 上传文件存储路径（容器内路径，无需修改）
UPLOADS_PATH=/app/uploads

# 日志文件存储路径（容器内路径，无需修改）
LOGS_PATH=/app/logs

# ---------- 邮件服务配置（可选，用于密码找回） ----------
# SMTP 服务器地址
MAIL_HOST=smtp.example.com
# SMTP 端口
MAIL_PORT=587
# SMTP 用户名
MAIL_USER=your-email@example.com
# SMTP 密码
MAIL_PASS=your-email-password
# 发件人显示
MAIL_FROM=MyNav <no-reply@example.com>

# ---------- Node 环境 ----------
NODE_ENV=production
